{
	"name": "@txnlab/nfd-sdk-monorepo",
	"private": true,
	"description": "Monorepo for NFDomains SDK and related packages",
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"test": "pnpm -r test",
		"lint": "pnpm -r lint",
		"format": "pnpm -r format",
		"clean": "pnpm -r clean",
		"publish:packages": "pnpm -r publish:package",
		"fetch:openapi": "pnpm -F @txnlab/nfd-sdk fetch:openapi",
		"fetch:arc56": "pnpm -F @txnlab/nfd-sdk fetch:arc56",
		"fetch:specs": "pnpm -F @txnlab/nfd-sdk fetch:specs"
	},
	"keywords": [
		"algorand",
		"nfd",
		"nfdomains",
		"blockchain",
		"domains",
		"sdk"
	],
	"author": "TxnLab Inc.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TxnLab/nfd-sdk.git"
	},
	"bugs": {
		"url": "https://github.com/TxnLab/nfd-sdk/issues"
	},
	"homepage": "https://github.com/TxnLab/nfd-sdk#readme",
	"engines": {
		"node": ">=18",
		"pnpm": ">=8"
	}
}
