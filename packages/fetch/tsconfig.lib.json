{
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "lib"
  ],
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "5.0",
    "allowJs": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleResolution": "node",
    "module": "esnext",
    "target": "esnext",
    "sourceMap": true,
    "declaration": true,
    "outDir": "./lib"
  },
}
