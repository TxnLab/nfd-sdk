{
  "name": "@txnlab/nfd-sdk",
  "version": "0.1.0",
  "description": "SDK for interacting with NFDomains (NFD) API and Algorand blockchain",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "publish:package": "node scripts/publish.js",
    "fetch:openapi": "tsx scripts/fetch-openapi.ts",
    "fetch:arc56": "tsx scripts/fetch-arc56.ts",
    "fetch:specs": "pnpm fetch:openapi && pnpm fetch:arc56",
    "generate:clients": "algokit generate client src/contracts/ --language typescript --output src/contracts/{contract_name}Client.ts",
    "generate:openapi": "openapi-ts",
    "generate": "pnpm fetch:specs && pnpm generate:clients && pnpm generate:openapi"
  },
  "keywords": [
    "algorand",
    "nfd",
    "nfdomains",
    "blockchain",
    "domains",
    "sdk"
  ],
  "author": "TxnLab Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TxnLab/nfd-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/TxnLab/nfd-sdk/issues"
  },
  "homepage": "https://github.com/TxnLab/nfd-sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-client-generator": "4.0.2",
    "@hey-api/openapi-ts": "^0.64.5",
    "@tanstack/config": "^0.16.2",
    "@types/crypto-js": "^4.2.2",
    "@types/node-fetch": "^2.6.12",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "dotenv": "^16.4.7",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-unicorn": "^57.0.0",
    "node-fetch": "^3.3.2",
    "prettier": "^3.5.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.5.3"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "8.0.0",
    "@hey-api/client-fetch": "^0.8.1",
    "algosdk": "^3.2.0",
    "crypto-js": "^4.2.0"
  }
}
