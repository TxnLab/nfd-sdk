{
  "name": "@txnlab/nfd-sdk",
  "version": "2.0.0",
  "description": "JS SDK for interacting with NFDomains (NFD) directly on-chain and via API",
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./lookup": {
      "import": {
        "types": "./dist/types/lookup.d.ts",
        "default": "./dist/esm/lookup.js"
      },
      "require": {
        "types": "./dist/types/lookup.d.cts",
        "default": "./dist/cjs/lookup.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "algorand",
    "nfd",
    "nfdomains",
    "blockchain",
    "domains",
    "sdk"
  ],
  "author": "TxnLab Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TxnLab/nfd-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/TxnLab/nfd-sdk/issues"
  },
  "homepage": "https://github.com/TxnLab/nfd-sdk#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "vite build && publint --strict",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "fetch:openapi": "tsx scripts/fetch-openapi.ts",
    "fetch:arc56": "tsx scripts/fetch-arc56.ts",
    "postfetch:arc56": "tsx scripts/clean-arc56.ts",
    "fetch:specs": "pnpm fetch:openapi && pnpm fetch:arc56",
    "generate:clients": "algokit generate client src/contracts/minimal/ --language typescript --output src/contracts/{contract_name}Client.ts",
    "generate:openapi": "openapi-ts",
    "generate": "pnpm fetch:specs && pnpm generate:clients && pnpm generate:openapi"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^8.2.2"
  },
  "peerDependencies": {
    "algosdk": "^3.6.0"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-client-generator": "^4.0.9",
    "@hey-api/openapi-ts": "^0.99.0",
    "@tanstack/config": "^0.16.3",
    "@types/node": "^22.20.1",
    "@types/node-fetch": "^2.6.13",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "algosdk": "^3.7.0",
    "dotenv": "^16.6.1",
    "node-fetch": "^3.3.2",
    "publint": "^0.3.24",
    "tsx": "^4.23.12",
    "type-fest": "^4.41.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
