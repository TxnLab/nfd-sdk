{
  "name": "@txnlab/nfd-sdk",
  "version": "0.1.0",
  "description": "SDK for interacting with NFDomains (NFD) API and Algorand blockchain",
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && publint --strict",
    "test": "jest",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "format": "prettier --write .",
    "publish:package": "node scripts/publish.js",
    "fetch:openapi": "tsx scripts/fetch-openapi.ts",
    "fetch:arc56": "tsx scripts/fetch-arc56.ts",
    "fetch:specs": "pnpm fetch:openapi && pnpm fetch:arc56",
    "generate:clients": "algokit generate client src/contracts/ --language typescript --output src/contracts/{contract_name}Client.ts",
    "generate:openapi": "openapi-ts",
    "generate": "pnpm fetch:specs && pnpm generate:clients && pnpm generate:openapi"
  },
  "keywords": [
    "algorand",
    "nfd",
    "nfdomains",
    "blockchain",
    "domains",
    "sdk"
  ],
  "author": "TxnLab Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TxnLab/nfd-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/TxnLab/nfd-sdk/issues"
  },
  "homepage": "https://github.com/TxnLab/nfd-sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-client-generator": "^4.0.8",
    "@hey-api/openapi-ts": "^0.64.5",
    "@tanstack/config": "^0.16.2",
    "@types/crypto-js": "^4.2.2",
    "@types/node-fetch": "^2.6.12",
    "dotenv": "^16.4.7",
    "node-fetch": "^3.3.2",
    "publint": "^0.3.6",
    "tsx": "^4.19.3",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^8.2.2",
    "@hey-api/client-fetch": "^0.8.1",
    "algosdk": "^3.2.0",
    "crypto-js": "^4.2.0"
  }
}
